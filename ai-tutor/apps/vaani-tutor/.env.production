# ====================================
# Vaani (Hindi AI Tutor) - Production Environment
# ====================================
# DO NOT COMMIT THIS FILE WITH REAL API KEYS
# Use .env.local for development
# ====================================

# Node Environment
NODE_ENV=production

# Server Configuration
PORT=3001
HOSTNAME=0.0.0.0

# ====================================
# Text-to-Speech (TTS) Configuration
# ====================================
# Using Sarvam AI for Indian language TTS

SARVAM_API_KEY=sk_cwhnhxa6_FkMJCdTEgoD6WIaWzOmwRVAQ
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=meera

# ====================================
# Next.js Configuration
# ====================================

# Enable React strict mode for development checks
NEXT_PUBLIC_STRICT_MODE=true

# Base path for the app (if serving from subdirectory)
NEXT_PUBLIC_BASE_PATH=/vaani

# ====================================
# Logging & Monitoring
# ====================================

# Set to 'debug' for verbose logging, 'info' for normal
LOG_LEVEL=info

# Sentry error tracking (optional - configure if needed)
# SENTRY_DSN=https://example@sentry.io/12345
# SENTRY_ENVIRONMENT=production

# ====================================
# Security
# ====================================

# Session configuration (if using sessions)
# SESSION_SECRET=your-secret-key-here

# CORS allowed origins (if API has CORS restrictions)
# CORS_ORIGINS=https://robodynamics.in

# ====================================
# Feature Flags (Optional)
# ====================================

# Enable/disable certain features
NEXT_PUBLIC_ENABLE_PARENT_MODE=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true

# ====================================
# MySQL Database (Progress Tracking & Gamification)
# ====================================
# Vaani progress sync: stores lesson completions, XP, badges, streaks
# Required for persistent progress across devices/sessions

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=vaani_user
MYSQL_PASSWORD=vaani_secure_password_change_me
MYSQL_DATABASE=vaani_prod

# ====================================
# Legacy PostgreSQL (Deprecated)
# ====================================

# DATABASE_URL=postgresql://user:password@localhost:5432/vaani_prod
# DATABASE_POOL_SIZE=10

# ====================================
# CDN & Asset Configuration
# ====================================

# Image optimization
NEXT_PUBLIC_ASSET_PREFIX=/vaani
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true

# ====================================
# Notes
# ====================================
# - SARVAM_API_KEY: Use production key from Sarvam AI dashboard
# - Update SARVAM_SPEAKER if needed (options: meera, default, etc.)
# - Add DATABASE_URL once PostgreSQL persistence is implemented
# - Enable Sentry for production error tracking
# - Keep API keys secure - use .env.production.local for actual keys
