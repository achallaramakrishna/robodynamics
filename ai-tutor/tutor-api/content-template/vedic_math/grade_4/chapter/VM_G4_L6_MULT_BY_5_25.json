  "coreIdeas": [
    "×5 = halve the number then multiply by 10 — because 5 = 10 ÷ 2.",
    "×25 = divide the number by 4 then multiply by 100 — because 25 = 100 ÷ 4.",
    "When the number is odd, multiply by 10 (or 100) first, then divide to avoid fractions."
  ],
