      "title": "35² — Ending in 5 Shortcut",
      "problem": "Find 35²",
      "steps": [
        "n = 35, tens digit = 3",
        "Multiply tens digit by (tens digit + 1): 3 × 4 = 12",
        "Append 25: answer = 1225"
      ],
      "answer": "35² = 1225"
    },
    {
      "id": "we2",
      "title": "47² — Near 50",
      "problem": "Find 47²",
      "steps": [
        "47 = 50 − 3",
        "(50−3)² = 50² − 2×50×3 + 3²",
        "= 2500 − 300 + 9",
        "= 2209"
      ],
      "answer": "47² = 2209"
    },
    {
      "id": "we3",
      "title": "96² — Near 100",
      "problem": "Find 96²",
      "steps": [
        "96 = 100 − 4",
        "(100−4)² = 100² − 2×100×4 + 4²",
        "= 10000 − 800 + 16",
        "= 9216"
      ],
      "answer": "96² = 9216"
    },
    {
      "id": "we4",
      "title": "63² — Using Base 60",
      "problem": "Find 63²",
      "steps": [
        "63 = 60 + 3",
        "(60+3)² = 60² + 2×60×3 + 3²",
        "= 3600 + 360 + 9",
        "= 3969"
      ],
      "answer": "63² = 3969"
    }
  ],
