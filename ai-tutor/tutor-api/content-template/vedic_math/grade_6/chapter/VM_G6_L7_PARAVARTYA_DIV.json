      "title": "135 ÷ 9 — Running Sum",
      "problem": "Divide 135 by 9",
      "steps": [
        "Digits of 135: 1, 3, 5",
        "Bring down first digit: Q₁ = 1",
        "Running sum: 1 + 3 = 4 → Q₂ = 4",
        "Running sum: 4 + 5 = 9 = 9×1 → Q₃ next digit completes",
        "Quotient = 15, remainder = 0",
        "Check: 9 × 15 = 135 ✓"
      ],
      "answer": "135 ÷ 9 = 15"
    },
    {
      "id": "we2",
      "title": "253 ÷ 11 — Alternating Subtract",
      "problem": "Divide 253 by 11",
      "steps": [
        "Digits: 2, 5, 3",
        "Alternating sum (left to right, alternating +−): 2 − 5 + 3 = 0 → divisible",
        "Paravartya for 11: complement of 11 from 10 is −1",
        "Step: bring 2, multiply by 1 → add to next: 2+2=... result: Q=23, R=0",
        "Check: 11 × 23 = 253 ✓"
      ],
      "answer": "253 ÷ 11 = 23"
    },
    {
      "id": "we3",
      "title": "256 ÷ 12 — Paravartya",
      "problem": "Divide 256 by 12",
      "steps": [
        "Divisor 12. Complement from 10: 12 − 10 = 2, so adjust digit is −2",
        "Set up: 2 | 5 6 with flag digit 2",
        "Bring down 2 as first quotient digit",
        "2 × (−2) = −4. 5 + (−4) = 1. Next quotient digit: 1",
        "1 × (−2) = −2. 6 + (−2) = 4. Remainder = 4",
        "Quotient = 21, Remainder = 4",
        "Check: 12 × 21 + 4 = 252 + 4 = 256 ✓"
      ],
      "answer": "256 ÷ 12 = 21 remainder 4"
    },
    {
      "id": "we4",
      "title": "1452 ÷ 12 — Paravartya on 4 Digits",
      "problem": "Divide 1452 by 12",
      "steps": [
        "Divisor 12, flag/adjust digit = −2",
        "Dividend digits: 1, 4, 5, 2",
        "Step 1: Bring 1 → Q₁ = 1. 1×(−2) = −2. 4+(−2) = 2",
        "Step 2: Q₂ = 2. 2×(−2) = −4. 5+(−4) = 1",
        "Step 3: Q₃ = 1. 1×(−2) = −2. 2+(−2) = 0",
        "Remainder = 0. Quotient = 121",
        "Check: 12 × 121 = 1452 ✓"
      ],
      "answer": "1452 ÷ 12 = 121"
    }
  ],
