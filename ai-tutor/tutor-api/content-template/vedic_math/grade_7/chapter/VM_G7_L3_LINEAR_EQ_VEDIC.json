  "learningGoals": [
    "Apply Paravartya (transpose) sutra: move any term across = by flipping its sign.",
    "Use Anurupyena (proportionally) sutra to spot proportional solutions instantly.",
    "Solve linear equations in one variable including fractional and word-problem forms."
  ],
  "coreIdeas": [
    "Paravartya: any term moves to the other side of = with its sign reversed.",
    "Anurupyena: if both sides scale proportionally, the solution is immediate.",
    "Clear fractions by multiplying both sides by the denominator before transposing."
  ],
  "workedExamples": [
    {
      "question": "x + 7 = 12 — Solve for x.",
      "method": "Transpose 7: x = 12 − 7 = 5.",
      "answer": "x = 5"
    },
    {
      "question": "3x − 5 = 10 — Solve for x.",
      "method": "Transpose −5: 3x = 15. Divide: x = 5.",
      "answer": "x = 5"
    },
    {
      "question": "x/3 + 2 = 6 — Solve for x.",
      "method": "Transpose 2: x/3 = 4. Multiply by 3: x = 12.",
      "answer": "x = 12"
    },
    {
      "question": "2x + 3 = x + 7 — Solve for x.",
      "method": "Transpose x: 2x − x = 7 − 3. x = 4.",
      "answer": "x = 4"
    }
  ],
