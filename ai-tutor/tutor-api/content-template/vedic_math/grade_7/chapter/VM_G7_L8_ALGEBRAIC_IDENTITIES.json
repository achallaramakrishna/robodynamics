  "learningGoals": [
    "Expand (a+b)², (a−b)², and (a+b)(a−b) from the Anurupyena identity pattern at speed.",
    "Apply the (a+b)² identity numerically to compute squares of numbers like 51, 103 mentally.",
    "Factorise perfect-square trinomials and difference-of-squares expressions using identity recognition."
  ],
  "coreIdeas": [
    "Anurupyena (proportionality): (a+b)² = a² + 2ab + b². The middle term 2ab is always double the product of the two parts.",
    "Difference of squares: (a+b)(a−b) = a²−b². The cross terms cancel — making it the fastest multiplication identity.",
    "Factorisation is the identity run backwards: recognise the pattern, read off a and b, write the factored form."
  ],
  "workedExamples": [
    {
      "question": "Expand (x+5)²",
      "method": "a=x, b=5. (x+5)² = x² + 2(x)(5) + 5² = x² + 10x + 25.",
      "answer": "x² + 10x + 25"
    },
    {
      "question": "Compute 51² mentally.",
      "method": "51 = 50+1. (50+1)² = 50² + 2×50×1 + 1² = 2500 + 100 + 1 = 2601.",
      "answer": "2601"
    },
    {
      "question": "Expand (2x−3)²",
      "method": "a=2x, b=3. (2x−3)² = (2x)² − 2(2x)(3) + 3² = 4x² − 12x + 9.",
      "answer": "4x² − 12x + 9"
    },
    {
      "question": "Factorise x² + 6x + 9",
      "method": "Recognise perfect square: a²+2ab+b² with a=x, b=3. So (x+3)².",
      "answer": "(x+3)²"
    }
  ],
  "starterPractice": [
    "Warm-up: What is a² + 2ab + b² when a=2 and b=3? Evaluate both sides.",
    "Guided: Expand (x+4)² step by step using the identity.",
    "Independent: Compute 99² using (100−1)² identity."
  ],
