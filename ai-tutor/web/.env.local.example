# ─────────────────────────────────────────────────────────────────────────────
# MoneyMind — Feature Flags
# Copy this file to .env.local and set values for local development.
# In production, set these as environment variables on your server/Vercel/Render.
# ─────────────────────────────────────────────────────────────────────────────

# Razorpay checkout page (/checkout?bundle=moneymind-6-levels)
# Set to true when Razorpay integration is ready and tested
NEXT_PUBLIC_MONEYMIND_CHECKOUT_ENABLED=false

# Financial Baseline Test (/ai-tutor/demo?product=moneymind)
# Set to true when the 10-question baseline quiz is built
NEXT_PUBLIC_MONEYMIND_BASELINE_TEST_ENABLED=false

# XP Badge / Certificate screen shown at end of each level
# Set to true when the badge component is built
NEXT_PUBLIC_MONEYMIND_XP_BADGE_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay (needed when MONEYMIND_CHECKOUT_ENABLED=true)
# ─────────────────────────────────────────────────────────────────────────────
# Test keys from https://dashboard.razorpay.com — safe for dev/staging
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME

# ─────────────────────────────────────────────────────────────────────────────
# API Base URL
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8091
